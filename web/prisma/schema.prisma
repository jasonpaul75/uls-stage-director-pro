// ULS Stage Director PRO — PostgreSQL schema (v1 foundations)
// Product rules: docs in /ULS_Stage_Director_PRO.md at repo root

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  DIRECTOR
  PRODUCER
  ULS_ADMIN
  /// Internal crew — sees `/staff` (assigned productions + availability calendar only).
  STAFF
}

enum StaffAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
}

enum StaffTaxDocumentKind {
  W9
  W2
}

enum ProjectRole {
  DIRECTOR
  PRODUCTION
}

enum ProjectStatus {
  INTAKE_DRAFT
  INTAKE_SUBMITTED
}

enum SupportTicketStatus {
  OPEN
  RESOLVED
}

enum ProjectAttachmentKind {
  CONTRACT
  INSURANCE_COMPLIANCE
}

enum ShowMediaLane {
  MUSIC
  VIDEO
}

/// Proportional stage diagram authoring (2D CAD-class trajectory); authoring is producer-internal until viewer surfaces ship.
enum StageDesignUnit {
  FEET
  METERS
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String?
  globalRole   GlobalRole @default(DIRECTOR)

  memberships           ProjectMember[]
  assignedProjects      Project[]               @relation("ProjectAssignee")
  directorInvitesSent   DirectorInvite[]        @relation("DirectorInviteSentBy")
  passwordResetTokens PasswordResetToken[]
  supportTicketsCreated SupportTicket[] @relation("SupportTicketAuthor")
  projectAttachmentsUploaded ProjectAttachment[] @relation("ProjectAttachmentUploader")
  projectShowMediaUploaded     ProjectShowMediaItem[] @relation("ProjectShowMediaUploader")
  directorSharesUploaded ProjectDirectorShare[] @relation("ProjectDirectorShareUploader")
  showMediaLibraryUploaded     ShowMediaLibraryItem[] @relation("ShowMediaLibraryUploader")
  stageDesignsLastUpdated ProjectStageDesign[]       @relation("StageDesignLastUpdatedBy")

  staffAssignmentsAsStaff ProjectStaffAssignment[] @relation("StaffAssignmentSubject")
  staffAssignmentsCreated ProjectStaffAssignment[] @relation("StaffAssignmentCreator")
  staffAvailabilityDays   StaffAvailabilityDay[]
  staffTaxDocuments       StaffTaxDocument[]
  staffQuestionnaires     StaffEventQuestionnaire[]

  fixtureLibrarySharedPresetsUpdated FixtureLibrarySharedPreset[] @relation("FixtureLibrarySharedPresetUpdatedBy")
  fixtureLibrarySharedAuditLogs    FixtureLibrarySharedAuditLog[] @relation("FixtureLibrarySharedAuditActor")

  diagramLayerSharedPresetsUpdated DiagramLayerSharedPreset[] @relation("DiagramLayerSharedPresetUpdatedBy")
  diagramLayerSharedAuditLogs    DiagramLayerSharedAuditLog[] @relation("DiagramLayerSharedAuditActor")

  /// When set, sign-in with password is refused (invite-only revocation). Session invalidation remains session TTL.
  disabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Project {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  eventConclusionAt DateTime?

  /// Set when ULS confirms contract + initial payment — unlocks operational show workspace for directors.
  bookingSecuredAt DateTime?

  status              ProjectStatus @default(INTAKE_DRAFT)
  venue               String?
  cityState           String?
  requestedEventStart DateTime?
  requestedEventEnd   DateTime?
  categoryNotes       String?       @db.Text
  contestantApprox    Int?
  livestreamNotes     String?       @db.Text
  budgetNotes         String?       @db.Text
  additionalNotes     String?       @db.Text
  submittedAt         DateTime?

  internalNotes    String? @db.Text
  assignedToUserId String?
  assignedTo       User?   @relation("ProjectAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  /// Legal/compliance pause on automated platform retention (purge runbook respects this flag).
  retentionLegalHold     Boolean @default(false)
  retentionLegalHoldNote String? @db.VarChar(2000)

  memberships     ProjectMember[]
  directorInvites DirectorInvite[]

  // ULS Stripe account — buyer pays ULS per spec; customer + invoices scoped here.
  stripeCustomerId String? @unique
  stripeInvoices   ProjectStripeInvoice[]

  // Producer-authored proposal worksheet (directors see it when toggled on).
  proposalPricingNotes    String?   @db.Text
  proposalTechRiderNotes  String?   @db.Text
  proposalCrewNotes       String?   @db.Text
  proposalDirectorVisible Boolean   @default(false)
  contractsDirectorVisible     Boolean @default(false)
  stripeBillingDirectorVisible   Boolean @default(false)

  // Post-event pointers — gallery via SmugMug (Pageant Expressions); Castr for livestream/replay. Hosts own media per spec.
  postEventSmugMugUrl           String? @db.VarChar(2048)
  postEventCastrUrl             String? @db.VarChar(2048)
  postEventVaultDirectorVisible    Boolean @default(false)

  // Show day — informational "Flag-it" notes (no SLA). Producer-authored; optional director visibility.
  showDayFlagsDirectorVisible Boolean @default(false)

  // v2 — show media playlists (S3); producer upload + reorder; directors stream when published.
  showMediaDirectorVisible Boolean @default(false)

  // v3 — scaled stage diagram; directors see read-only footprint when published (after booking secured).
  stageDesignDirectorVisible Boolean @default(false)

  // Run of show — producer-authored schedule narrative; freeze hints view-only show window (directors never edit in portal v1).
  runOfShowBody            String?  @db.Text
  runOfShowDirectorVisible Boolean  @default(false)
  runOfShowFrozen          Boolean  @default(false)

  // DocuSign: linked envelopes — DocuSign is system of record; we mirror status metadata + IDs.
  docuSignEnvelopes ProjectDocuSignEnvelope[]
  supportTickets    SupportTicket[]
  showDayFlags      ProjectShowFlag[]
  attachments       ProjectAttachment[]
  showMediaItems    ProjectShowMediaItem[]
  directorShares    ProjectDirectorShare[]
  stageDesign       ProjectStageDesign?

  /// Producer Crew & ops roster (GlobalRole.STAFF). On Project queries use relation field staffAssignments — not projectStaffAssignments.
  staffAssignments    ProjectStaffAssignment[]
  staffQuestionnaires StaffEventQuestionnaire[]
  expenseLines        ProjectExpenseLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([assignedToUserId])
}

model ProjectShowFlag {
  id        String   @id @default(cuid())
  projectId String
  body      String   @db.VarChar(2000)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// v2 — one row per track in a lane-ordered playlist (audio or video). Stored in S3 under `project-show-media/` prefix.
model ProjectShowMediaItem {
  id        String        @id @default(cuid())
  projectId String
  lane      ShowMediaLane
  sortOrder Int           @default(0)
  fileName  String        @db.VarChar(420)
  contentType String      @db.VarChar(200)
  sizeBytes Int
  storageKey String       @unique @db.VarChar(520)

  uploadedByUserId String
  uploadedBy       User   @relation("ProjectShowMediaUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([projectId, lane, sortOrder])
}

/// v2 — director-supplied audio/video for production sharing (distinct from producer show-media playlists).
model ProjectDirectorShare {
  id          String @id @default(cuid())
  projectId   String
  fileName    String @db.VarChar(420)
  contentType String @db.VarChar(200)
  sizeBytes   Int
  storageKey  String @unique @db.VarChar(520)
  note        String? @db.VarChar(500)

  uploadedByUserId String
  uploadedBy User @relation("ProjectDirectorShareUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([uploadedByUserId])
}

/// Producer-owned reusable cues — S3 under `show-media-library/`; import copies into project playlists.
model ShowMediaLibraryItem {
  id        String        @id @default(cuid())
  lane      ShowMediaLane
  fileName  String        @db.VarChar(420)
  contentType String      @db.VarChar(200)
  sizeBytes Int
  storageKey String       @unique @db.VarChar(520)

  uploadedByUserId String
  uploadedBy       User   @relation("ShowMediaLibraryUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([lane])
  @@index([createdAt])
}

model SupportTicket {
  id              String @id @default(cuid())
  projectId       String
  createdByUserId String
  subject         String @db.VarChar(200)
  body            String @db.Text
  status          SupportTicketStatus @default(OPEN)
  producerReply   String? @db.Text
  resolvedAt      DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("SupportTicketAuthor", fields: [createdByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

// Producer-invited director; raw token emailed once — tokenHash only in DB.
model DirectorInvite {
  id              String    @id @default(cuid())
  email           String
  tokenHash       String    @unique
  projectId       String
  invitedByUserId String
  expiresAt       DateTime
  consumedAt      DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("DirectorInviteSentBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([email])
}

// Time-limited link to reset password (raw token hashed like director invites).
model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model ProjectStripeInvoice {
  id               String @id @default(cuid())
  projectId        String
  stripeInvoiceId  String @unique
  status           String
  hostedInvoiceUrl String?
  invoiceNumber    String?
  amountDueCents   Int?
  /// Stripe Invoice.amount_paid (smallest currency unit).
  amountPaidCents Int?
  /// Stripe Invoice.total — billed face total before Net-of-credits semantics vary (see Stripe docs).
  totalCents       Int?
  currency         String @default("usd")

  // Stripe billing retry attempts + schedule (hosted invoice flow).
  attemptCount           Int?
  nextPaymentAttemptAt   DateTime?
  lastStripeErrorSummary String?   @db.VarChar(500)
  lastSyncedFromStripeAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// Producer-linked DocuSign envelope metadata (mirror only — DocuSign remains source of truth).
model ProjectDocuSignEnvelope {
  id         String @id @default(cuid())
  projectId  String
  envelopeId String @unique
  subject    String?

  status            String @default("unknown")
  statusChangedAt   DateTime?
  completedAt       DateTime?
  voidedAt          DateTime?
  lastWebhookEvent  String?
  producerNote      String? @db.VarChar(2000)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// Idempotent record of DocuSign Connect webhook deliveries (HMAC validated before persist).
model DocuSignInboundEvent {
  id                 String @id @default(cuid())
  payloadHashSha256  String @unique
  envelopeId         String?
  eventType          String?
  payload            Json

  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([envelopeId])
}

model StripeInboundEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  livemode      Boolean  @default(false)
  payload       Json

  processedAt DateTime?

  createdAt DateTime @default(now())
}

/// ULS-held confidential uploads (contracts, insurance/compliance). Never exposed on director-facing routes — server-enforced producer/admin only.
model ProjectAttachment {
  id               String               @id @default(cuid())
  projectId        String
  kind             ProjectAttachmentKind
  fileName         String               @db.VarChar(420)
  contentType      String               @db.VarChar(200)
  sizeBytes        Int
  storageKey       String               @unique @db.VarChar(520)

  uploadedByUserId String
  uploadedBy       User                 @relation("ProjectAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
}

model ProjectMember {
  id     String @id @default(cuid())
  role   ProjectRole
  userId String
  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

/// Producer assigns internal crew (globalRole STAFF) to a submitted intake production.
model ProjectStaffAssignment {
  id               String @id @default(cuid())
  projectId        String
  staffUserId      String
  duties           String? @db.Text
  assignedByUserId String?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staffUser  User    @relation("StaffAssignmentSubject", fields: [staffUserId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("StaffAssignmentCreator", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, staffUserId])
  @@index([staffUserId])
  @@index([projectId])
}

/// Staff-authored availability — applies across productions when judging conflicts (calendar UX).
model StaffAvailabilityDay {
  id     String                  @id @default(cuid())
  userId String
  date   DateTime                @db.Date
  status StaffAvailabilityStatus
  note   String?                 @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

/// Confidential tax uploads — stored like producer attachments; staff uploads; producers/admins audit-download only.
model StaffTaxDocument {
  id          String               @id @default(cuid())
  userId      String
  kind        StaffTaxDocumentKind
  fileName    String               @db.VarChar(420)
  contentType String               @db.VarChar(200)
  sizeBytes   Int
  storageKey  String               @unique @db.VarChar(520)
  uploadedAt  DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Producer-visible questionnaire responses — travel / meals / payment notes per assigned staff member.
model StaffEventQuestionnaire {
  id           String @id @default(cuid())
  projectId    String
  staffUserId  String
  travelNotes  String? @db.Text
  foodNotes    String? @db.Text
  paymentNotes String? @db.Text
  otherNotes   String? @db.Text
  submittedAt  DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staffUser User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, staffUserId])
  @@index([staffUserId])
}

/// Producer-managed expense rows for operational / tax bookkeeping (not Stripe settlement truth).
model ProjectExpenseLine {
  id          String    @id @default(cuid())
  projectId   String
  label       String    @db.VarChar(240)
  category    String    @db.VarChar(80)
  amountCents Int
  incurredAt  DateTime?
  memo        String?   @db.VarChar(500)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
}

/// Scaled 2D stage plan (snapshot JSON evolves with richer diagram tooling).
model ProjectStageDesign {
  id        String           @id @default(cuid())
  projectId String           @unique
  title     String           @default("Stage diagram") @db.VarChar(200)
  unit      StageDesignUnit  @default(FEET)
  /// Schema version + shapes; validated in application code (milestones expand structure).
  canvasJson Json             @default("{}")
  updatedByUserId String
  updatedBy       User       @relation("StageDesignLastUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// Producer-hosted preset rows shared tenant-wide (fixture tagging vocabulary).
model FixtureLibrarySharedPreset {
  id        String @id @default(cuid())
  sortOrder Int    @default(0)
  label     String @db.VarChar(48)
  labelKey  String @unique @db.VarChar(48)
  equipment Json

  updatedByUserId String?
  updatedBy       User?   @relation("FixtureLibrarySharedPresetUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model FixtureLibrarySharedAuditLog {
  id          String @id @default(cuid())
  actorUserId String
  actor       User   @relation("FixtureLibrarySharedAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String @db.VarChar(48)
  detail      Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Producer-hosted named tier stacks shared tenant-wide (diagram layer templates).
model DiagramLayerSharedPreset {
  id        String @id @default(cuid())
  sortOrder Int    @default(0)
  label     String @db.VarChar(48)
  labelKey  String @unique @db.VarChar(48)
  tiers     Json

  updatedByUserId String?
  updatedBy       User?   @relation("DiagramLayerSharedPresetUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model DiagramLayerSharedAuditLog {
  id          String @id @default(cuid())
  actorUserId String
  actor       User   @relation("DiagramLayerSharedAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String @db.VarChar(48)
  detail      Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
}
