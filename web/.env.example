# Copy to `.env` (never commit secrets)

# Amazon RDS PostgreSQL in us-east-2 (example)
DATABASE_URL="postgresql://USER:PASSWORD@HOSTNAME:5432/stage_director_pro?sslmode=require"

# REQUIRED — Auth.js throws MissingSecret if unset
AUTH_SECRET="use_a_long_random_string_at_least_32_chars"

# Optional; dev base URL used in SES intake emails (link to inbox)
APP_BASE_URL="http://localhost:3000"

# Amazon SES — new intake notifies ULS; director-invite & password-reset messages use SES_FROM_EMAIL (sandbox: verify each recipient address).
AWS_REGION=us-east-2
# SES_FROM_EMAIL=verified-sender@yourdomain.com
# INTAKE_NOTIFY_EMAIL=producer1@ulis.com,producer2@ulis.com
# Use IAM user keys or SSO profile AWS_REGION + default credential chain — do not paste keys here

# Private S3 bucket for producer-only contract & compliance uploads (SSE-S3 objects; app issues presigned GETs).
# Also stores v2 show media under `uls-stage-director/project-show-media/`, reusable library cues under `uls-stage-director/show-media-library/` (same bucket IAM: Put/Get/Delete).
# AWS_S3_ATTACHMENTS_BUCKET=uls-stage-director-attachments-dev
# Grant s3:PutObject, s3:GetObject, s3:DeleteObject, s3:CopyObject on `uls-stage-director/project-attachments/*`, `uls-stage-director/project-show-media/*`, and `uls-stage-director/show-media-library/*` (CopyObject reads the source key and writes the destination key server-side).
#
# Browser uploads (show media / media library) use presigned PUT to this bucket — add an S3 CORS rule allowing PUT (and GET for verification) from your app origins, e.g. `http://localhost:3000` and `https://uls-stage-director-pro.app`, with AllowedHeader `*` or at least `Content-Type`.

# Optional: GET /api/cron/retention-preview with Authorization: Bearer <secret> lists projects past the 36‑month retention anchor without legal hold (runbook aid; does not delete data).
# CRON_RETENTION_PREVIEW_SECRET=

# Optional; Auth.js issuer URL if needed behind custom host
# AUTH_URL="http://localhost:3000"

# Stripe — ULS Standard account (payments to ULS; Connect deferred per product spec).
# Plan: keep TEST keys (`sk_test_…`, matching webhook secrets, Dashboard test mode) through v1/v2; adopt `sk_live_…` after v3 ship — no app code forces live.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Dashboard webhook URL ends with /api/webhooks/stripe (prefix with APP_BASE_URL). Enable invoice.* events.
# Dev: stripe listen --forward-to localhost:3000/api/webhooks/stripe

# DocuSign Connect (JSON SIM) — mirror envelope status metadata into Postgres.
# Connect is PER DocuSign account/environment: developer envelopes under apps-d must use Connect in DEMO Admin:
#   https://admindemo.docusign.com/authenticate?goTo=connect
# Production Connect at admin.docusign.com does NOT receive events from apps-d / demo envelopes.
# 1. In matching DocuSign Admin » Connect » Custom Connect » JSON SIM » URL = APP_BASE_URL + /api/webhooks/docusign
# 2. Enable “Include HMAC” / Basic HMAC and paste the SAME secret below.
DOCUSIGN_CONNECT_HMAC_SECRET=

# DocuSign REST (JWT) — optional; for server-to-server API calls (not required for Connect mirror only).
# Uses the same DEMO vs production host as DOCUSIGN_USE_DEMO (see docusign-admin.ts).
# Create an Integration Key + RSA keypair in Apps and Keys; impersonate sends as DOCUSIGN_USER_ID after one-time consent.
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=uuid-of-impersonated-user
# DOCUSIGN_RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# Optional override (otherwise account-d.docusign.com vs account.docusign.com):
# DOCUSIGN_AUTH_SERVER=account-d.docusign.com

# DEMO console links (recommended for dev): DOCUSIGN_USE_DEMO=true
# DOCUSIGN_USE_DEMO=true
